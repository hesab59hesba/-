```dart
import 'package:flutter/material.dart';
import 'package:app_name/models/user_model.dart';
import 'package:app_name/services/api_service.dart';

class AppProvider extends ChangeNotifier {
  // State variables (replaces JavaScript global state)
  List<User> _users = [];
  User? _currentUser;
  bool _isLoading = false;
  String? _errorMessage;

  // Getters
  List<User> get users => _users;
  User? get currentUser => _currentUser;
  bool get isLoading => _isLoading;
  String? get errorMessage => _errorMessage;

  final ApiService _apiService = ApiService();

  // Initialization
  Future<void> init() async {
    await fetchUsers();
  }

  // CRUD Operations
  Future<void> fetchUsers() async {
    _setLoading(true);
    try {
      _users = await _apiService.getUsers();
      _errorMessage = null;
    } catch (e) {
      _errorMessage = e.toString();
    } finally {
      _setLoading(false);
    }
  }

  Future<void> createUser(User user) async {
    try {
      final newUser = await _apiService.createUser(user);
      _users.add(newUser);
      notifyListeners();
    } catch (e) {
      _errorMessage = e.toString();
    }
  }

  Future<void> updateUser(User user) async {
    try {
      await _apiService.updateUser(user);
      final index = _users.indexWhere((u) => u.id == user.id);
      if (index != -1) {
        _users[index] = user;
        notifyListeners();
      }
    } catch (e) {
      _errorMessage = e.toString();
    }
  }

  Future<void> deleteUser(String userId) async {
    try {
      await _apiService.deleteUser(userId);
      _users.removeWhere((u) => u.id == userId);
      notifyListeners();
    } catch (e) {
      _errorMessage = e.toString();
    }
  }

  // Business Logic Methods
  List<User> searchUsers(String query) {
    if (query.isEmpty) return _users;
    return _users
        .where((user) =>
            user.fullName.toLowerCase().contains(query.toLowerCase()) ||
            user.email.toLowerCase().contains(query.toLowerCase()))
        .toList();
  }

  List<User> filterUsersByAge(int minAge) {
    return _users.where((user) => (user.age ?? 0) >= minAge).toList();
  }

  // Utility methods
  void _setLoading(bool value) {
    _isLoading = value;
    notifyListeners();
  }

  void clearError() {
    _errorMessage = null;
    notifyListeners();
  }
}
